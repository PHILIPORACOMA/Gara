# Copy to .env. Base URL of the Gara API (no trailing slash).
VITE_API_URL=http://localhost:4310/api

# Base URL used to load uploaded public images (portfolio, QR).
VITE_UPLOADS_URL=http://localhost:4310/uploads/public

# Show the booking, deposit and review screens. Keep "false" for the discovery version
# (workbook v3); must match FEATURE_BOOKINGS in server/.env.
VITE_FEATURE_BOOKINGS=false
