# Copy this file to .env and fill in real values. Never commit .env, and never put real
# passwords or secrets in THIS file: it is committed to git.

# Gara uses uncommon ports (API 4310, client 5310) so it does not clash with other local projects.
PORT=4310
NODE_ENV=development

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the empty database first (see root README). If your password has special
# characters (@ : / # ?), URL-encode them.
DATABASE_URL="mysql://root:your_password@localhost:3306/gara"

# Used only by integration tests (double-booking test and others). Must be a DIFFERENT database:
# the tests wipe its tables, and refuse to run unless its name contains "test". Prisma migrate needs
# permission to create a shadow DB, so use a MySQL user that can CREATE DATABASE (root is fine locally).
DATABASE_URL_TEST="mysql://root:your_password@localhost:3306/gara_test"

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the Vite client).
CLIENT_ORIGIN=http://localhost:5310

# Local upload folder (cloud storage is on the roadmap).
UPLOAD_DIR=./uploads

# Demo switch: let a pro mark a booking COMPLETED / NO_SHOW before the appointment time, so you
# can try the whole flow without waiting. Leave "false" in production.
ALLOW_EARLY_COMPLETE=false

# Workbook v3: Gara is a discovery and contact platform. Booking, deposit, commission and review
# routes stay off unless this is "true" (must match VITE_FEATURE_BOOKINGS in client/.env).
FEATURE_BOOKINGS=false
